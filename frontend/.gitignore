# =========================================================================
# ArchiTech Master GitIgnore Matrix
# =========================================================================

# 📦 Dependencies (Never upload node_modules!)
node_modules/
dist/
build/
.npm/
package-lock.json (Optional: can keep if you want strict lockfiles, but node_modules is the main culprit)

# 🔐 Private API Keys & Credentials
.env
.env.local
.env.production
.env.development
*.pem
*.key

# 🐳 Dynamic Scaffolding & Sandbox Outputs
# (Prevents test projects generated by your backend from polluting your clean Git tree)
backend/playground/
project_*
*.zip
*.tar.gz

# 🍏 System & OS Overhead Artifacts
.DS_Store
Thumbs.db
desktop.ini

# 🛠️ Editor & IDE Configuration Meta
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.trae/